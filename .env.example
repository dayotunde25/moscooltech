# =============================================================================
# Moscool Technical Services - environment template
# Copy this file to `.env` for LOCAL DEVELOPMENT only (or set the same keys in
# your Render service under Settings -> Environment). Never commit `.env`.
# =============================================================================

# Flask Configuration
FLASK_APP=app.py
# Set to "development" locally (enables the debugger + ephemeral secret key).
# In production this must be "production" (or unset) - debug mode is a security risk.
FLASK_ENV=development

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# REQUIRED on first deployment - the password of the "admin" account that is
# created automatically when the app boots against an empty database.
# Change it after logging in / redeploying is NOT enough - set a strong value now.
ADMIN_PASSWORD=

# Admin account email (optional, default: admin@moscooltech.com)
ADMIN_EMAIL=admin@moscooltech.com

# --- Database ---------------------------------------------------------------
# Local development uses SQLite. Production (Render) uses PostgreSQL:
#   postgres://...  ->  auto-converted to postgresql://... by the app.
DATABASE_URL=sqlite:///moscool_tech.db

# --- Optional: canonical/SEO base URL ---------------------------------------
# Only needed if robots.txt / sitemap.xml / social tags should use a fixed
# domain (e.g. https://moscooltech.com). If unset, the request's own host is used.
SITE_URL=https://moscooltech.com

# --- NewsData.io API (optional) ----------------------------------------------
# Free key from https://newsdata.io/ - enables auto/scheduled news fetching.
NEWSDATA_API_KEY=

# --- Sample content seeding ---------------------------------------------------
# When "true", the app inserts the sample portfolio case studies + SEO guide
# articles (seed_data.py) on first boot. Idempotent: existing slugs are never
# modified or duplicated. Set to false (or delete the key) on production if you
# prefer to seed manually via scripts/seed_portfolio.py / seed_articles.py.
SEED_SAMPLE_CONTENT=false

# --- Google Business Profile (local SEO) -------------------------------------
# Your GBP review short link from business.google.com -> "Ask for reviews"
# (format: https://g.page/r/XXXXXXXXXX/review). When unset, review buttons on
# the site fall back to a Google Maps search for the business.
GOOGLE_REVIEW_URL=

# --- Background scheduler -----------------------------------------------------
# Runs the daily news-fetch + cleanup jobs when the app is started with
# `python app.py`. Disable if you run multiple workers/processes (e.g. gunicorn).
ENABLE_SCHEDULER=true

# Port Configuration (Render sets this automatically)
PORT=5000
