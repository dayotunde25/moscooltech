# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production

# Security: Secret key for session encryption (REQUIRED - generate a strong random key)
SECRET_KEY=your-very-long-random-secret-key-change-this-in-production

# Database Configuration
# For production on Render, use PostgreSQL. For development, SQLite is fine.
DATABASE_URL=sqlite:///moscool_tech.db

# Admin Credentials (REQUIRED on first deployment)
# Set a strong password for the admin account
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_EMAIL=admin@moscooltech.com

# NewsData.io API Configuration (Optional)
# Get your free API key from: https://newsdata.io/
NEWSDATA_API_KEY=your-newsdata-api-key-here

# Port Configuration (Render will set this automatically)
PORT=5000
